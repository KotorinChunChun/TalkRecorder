#ifndef APP_FILENAME
#define APP_FILENAME "TalkRecorder.exe"
#endif
#ifndef APP_DESCRIPTION
#define APP_DESCRIPTION "TalkRecorder"
#endif

1 VERSIONINFO
FILEVERSION APP_VERSION
PRODUCTVERSION APP_VERSION
FILEOS 0x40004
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", APP_DESCRIPTION
            VALUE "FileVersion", APP_VERSION_TEXT
            VALUE "OriginalFilename", APP_FILENAME
            VALUE "ProductName", "TalkRecorder"
            VALUE "ProductVersion", APP_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
